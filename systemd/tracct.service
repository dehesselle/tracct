[Unit]
Description=tracct traffic accounting
# the retention purge compares against the wall clock; it skips the purge rather than
# wiping the db when the clock is behind, but a synced clock lets it run
Wants=time-sync.target
After=time-sync.target

[Service]
# READY=1 is sent once the BPF probes are attached, so ordering waits for capture
Type=notify
ExecStart=/opt/tracct/bin/tracct run
Restart=always
RestartSec=5

# an unprivileged dynamic user holding only the capabilities `tracct run` checks for,
# plus CAP_SYSLOG to read kernel symbol addresses (else io_uring zero-copy receives go uncounted)
DynamicUser=yes
AmbientCapabilities=CAP_BPF CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_SYSLOG
CapabilityBoundingSet=CAP_BPF CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_SYSLOG
NoNewPrivileges=yes
# lets the daemon hand its sockets to the static group from tracct.sysusers; set
# [viewer] group = "tracct-viewer" in config.toml and add viewers to the group; it can't
# be named tracct, DynamicUser= takes that name for the dynamic user and group
SupplementaryGroups=tracct-viewer

# exported as $CONFIGURATION_DIRECTORY, $STATE_DIRECTORY and $RUNTIME_DIRECTORY;
# the state directory is private to the dynamic user (/var/lib/private/tracct)
ConfigurationDirectory=opt/tracct
StateDirectory=tracct
RuntimeDirectory=tracct

# libbpf locks the BPF maps and ring buffers past the default 8 MiB
LimitMEMLOCK=infinity
# a safety net against a leak: by design the daemon stays below about 720 MB (a full writer
# queue, measured 717 MB); past this systemd kills it and Restart= starts it again
MemoryMax=1G

ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
